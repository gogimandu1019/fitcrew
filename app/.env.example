# Supabase 프로젝트 > Project Settings > API 에서 복사해 .env 로 저장하세요.
# 값이 없으면 앱은 "미리보기 모드"로 열려 화면만 둘러볼 수 있습니다.
# 주의: anon(공개) 키만 넣습니다. service_role·secret 키는 앱에 절대 넣지 않습니다.
EXPO_PUBLIC_SUPABASE_URL=https://<프로젝트-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 선택
# 베타 데모 크루 코드를 '크루 참여' 화면에 보여 줍니다 (설정 방법: supabase/ops/demo_group.sql)
EXPO_PUBLIC_DEMO_CODE=
# 개인정보 처리방침·약관 문서의 운영자명과 문의처
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_CONTACT_EMAIL=
# 웹에 게시한 처리방침 주소가 있으면 앱 안 문서 대신 이 주소를 엽니다
EXPO_PUBLIC_PRIVACY_URL=
